# Copy to .env.local for local development. Never commit real values.
#
# Which BoardService adapter the app starts with.
#   mock - MockBoardClient, deterministic review scenarios, no backend
#   http - HttpBoardClient against the configured backend
# Unset defaults to mock in `npm run dev` and http in a production build.
VITE_BOARD_CLIENT=mock

# Absolute origin of the separate backend deployment, no trailing slash.
# Frontend and backend are two independent projects - this is the supported
# way to point at the backend; the backend must allow this origin in its
# CORS_ALLOWED_ORIGINS. Leave unset only for the relative-/api/ dev-proxy
# fallback below.
VITE_API_BASE_URL=http://localhost:3000

# Dev-only convenience: where the Vite dev server forwards relative
# /api/... paths if VITE_API_BASE_URL is left unset. Not used when
# VITE_API_BASE_URL is set, and not used in a production build either way.
VITE_API_PROXY_TARGET=http://localhost:3000

# Optional local CV demo runner. Unset uses /cv-demo via Vite's loopback proxy.
# For this workspace's demo, the backend .env.local may use PORT=3001;
# match VITE_API_BASE_URL to that port. Production hosting needs its own routing.
# VITE_CV_BASE_URL=http://127.0.0.1:8765

# There is no Supabase key, service role key or database URL here by design.
# The frontend never talks to the database; the operator token is typed into
# the connect prompt at runtime and kept in memory only.
