# Copy to .env.local for local development. Never commit real values.
#
# Which BoardService adapter the app starts with.
#   mock - MockBoardClient, deterministic review scenarios, no backend
#   http - HttpBoardClient against same-origin /api
# Unset defaults to mock in `npm run dev` and http in a production build.
VITE_BOARD_CLIENT=mock

# Dev-only: where the Vite dev server forwards /api while the backend runs
# separately. Not used in a deployed build, where /api is same-origin.
VITE_API_PROXY_TARGET=http://localhost:3000

# There is no Supabase key, service role key or database URL here by design.
# The frontend never talks to the database; the operator token is typed into
# the connect prompt at runtime and kept in memory only.
